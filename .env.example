# One-Direction environment template

ONE_DIRECTION_ENV=local
ONE_DIRECTION_CONFIG=configs/local.yaml

PYTHONPATH=.

# Set to cuda, cpu, or auto
ONE_DIRECTION_DEVICE=auto

# Optional local paths
ONE_DIRECTION_DATA_DIR=data
ONE_DIRECTION_OUTPUT_DIR=outputs

# Optional experiment controls
ONE_DIRECTION_SEED=42
ONE_DIRECTION_NUM_WORKERS=2
