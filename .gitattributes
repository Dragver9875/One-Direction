# Normalize text files to LF in the repository
* text=auto eol=lf

# Source / config / docs
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.gitattributes text eol=lf
*.gitignore text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary / large artifacts
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.pdf binary
*.zip binary
*.pkl binary
*.pickle binary
*.pt binary
*.pth binary
*.ckpt binary
*.parquet binary
*.feather binary
*.arrow binary
*.npy binary
*.npz binary
*.h5 binary
*.hdf5 binary
*.osm binary
*.pbf binary
*.osm.pbf binary
*.gpkg binary
*.shp binary
*.shx binary
*.dbf binary
*.prj binary
*.cpg binary
