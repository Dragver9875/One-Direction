# ============================================================
# One-Direction .gitignore
# GNN-HMM map matching over OpenStreetMap road graphs
# ============================================================

# ----------------------------
# Python cache / bytecode
# ----------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# ----------------------------
# Virtual environments
# ----------------------------
.venv/
venv/
env/
ENV/
.conda/
conda-env/
*.egg-info/

# ----------------------------
# Build artifacts
# ----------------------------
build/
dist/
.eggs/
*.egg
pip-wheel-metadata/
wheelhouse/

# ----------------------------
# Python tooling caches
# ----------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.tox/
.nox/
.cache/

# ----------------------------
# Jupyter notebooks
# ----------------------------
.ipynb_checkpoints/
*.nbconvert.ipynb

# ----------------------------
# IDE / editor files
# ----------------------------
.vscode/
.idea/
*.swp
*.swo
*.swn
.DS_Store
Thumbs.db

# ----------------------------
# Logs
# ----------------------------
*.log
logs/
log/
wandb/
mlruns/
runs/
lightning_logs/
tensorboard/

# ----------------------------
# Environment variables / secrets
# ----------------------------
.env
.env.*
!.env.example
secrets.yaml
secrets.yml
credentials.json
token.json
*.pem
*.key

# ----------------------------
# Raw and processed data
# Keep directory placeholders, ignore heavy data files.
# ----------------------------
data/raw/**
data/interim/**
data/processed/**
data/reports/**

!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/reports/.gitkeep

# ----------------------------
# OSM / geospatial large files
# ----------------------------
*.osm
*.osm.pbf
*.pbf
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.gpkg
*.geojson
*.kml
*.kmz

# ----------------------------
# Parquet / tensor / serialized data
# ----------------------------
*.parquet
*.feather
*.arrow
*.pt
*.pth
*.pkl
*.pickle
*.joblib
*.npy
*.npz
*.h5
*.hdf5

# ----------------------------
# Model outputs
# ----------------------------
outputs/**
!outputs/.gitkeep

checkpoints/
*.ckpt
*.onnx
*.engine
*.trt
*.safetensors

# ----------------------------
# Generated figures and reports
# ----------------------------
figures/
plots/
reports/
*.png
*.jpg
*.jpeg
*.webp
*.svg
*.pdf

# ----------------------------
# Temporary files
# ----------------------------
tmp/
temp/
.tmp/
*.tmp
*.bak
*.old

# ----------------------------
# OS-specific files
# ----------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini

# ----------------------------
# Optional local configs
# ----------------------------
configs/local.yaml
configs/local.yml
configs/debug.yaml
configs/debug.yml
# ==============================================================================
# IISc / map_data6 / Mapviz local deployment artifacts
# ==============================================================================

# Local Ubuntu/ROS helper environment
.venv-iisc/
run_iisc.sh.bak_*
*.avi

# Local ROS bag files and copied bag directories
map_data6/
map_data6_*.db3
metadata.yaml

# IISc-specific OSM/map files
data/raw/osm/iisc_campus.osm
data/raw/osm/iisc_campus.osm.*
data/raw/osm/*iisc*.osm
data/raw/osm/*IISc*.osm

# IISc extracted GNSS / local trajectory files
data/raw/trajectories/points.csv
data/raw/trajectories/map_data6_points_wkt.csv
data/raw/trajectories/*map_data6*.csv
data/raw/trajectories/*iisc*.csv
data/raw/trajectories/*IISc*.csv

# IISc processed graph/candidate/tensor artifacts
data/interim/trajectory_clean.parquet
data/interim/empty_gt_routes.parquet
data/processed/road_graph/
data/processed/line_graph/
data/processed/candidates/
data/processed/splits/
data/processed/tensors/infer_dataset.pt

# IISc reports
data/reports/map_data6_*.json
data/reports/*iisc*.json
data/reports/*IISc*.json

# IISc / Mapviz outputs
outputs/mapviz/
outputs/matches/map_data6_*.parquet
outputs/matches/*iisc*.parquet
outputs/matches/*IISc*.parquet

# Local Mapviz config or captures if accidentally copied into repo
.mapviz_config
.mapviz_config.*
mapviz_*.avi

# Local IISc runner/config
configs/map_data6_iisc.yaml
run_iisc.sh
scripts/08_decode_gnn_hmm.py.bak_windowspath_20260603_181755
scripts/18_publish_matches_to_mapviz.py.bak_local_xy_20260603_182844
